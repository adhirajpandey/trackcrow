# Local development values. Copy to .env and fill in the Google OAuth client.
# Never put production credentials in a checkout's .env.

# Local Docker Compose database from docker-compose.yml. Reset it with `pnpm db:reset`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/trackcrow

# Local-only secret. Sessions signed with it are valid only against the local app.
NEXTAUTH_SECRET=trackcrow-local-development-secret
NEXTAUTH_URL=http://localhost:3000
OAUTH_ISSUER_URL=http://localhost:3000

# A Google OAuth client that allows http://localhost:3000 as a redirect origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional.
MCP_ALLOWED_ORIGINS=
LOG_LEVEL=

# scripts/screenshot_pages.py. The session email and detail IDs match rows in prisma/seed.sql.
TRACKCROW_UI_IMAGE_OUTPUT_DIR=scripts/outputs/screenshots
TRACKCROW_CHROME_EXECUTABLE=/path/to/chrome
TRACKCROW_AUTOMATION_USER_DATA_DIR=/path/to/chrome-automation-profile
TRACKCROW_AUTOMATION_SESSION_USER_EMAIL=pandey.adhiraj02@gmail.com
TRACKCROW_AUTOMATION_TRANSACTION_ID=7341932c-2bf1-45af-b611-8b540e589f17
TRACKCROW_AUTOMATION_RECIPIENT_ID=07a64e9a-3071-5e42-ab23-cede6fb845fc
