{
  "expo": {
    "name": "TrackCrow",
    "slug": "trackcrow-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand.png",
    "userInterfaceStyle": "light",
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "app.trackcrow.mobile",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.RECORD_AUDIO"
      ],
      "allowBackup": false
    },
    "scheme": "trackcrow",
    "platforms": [
      "android"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "./plugins/with-release-signing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
